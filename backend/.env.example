APP_ENV=development
APP_NAME=Personal Finance Tracking Platform
APP_VERSION=0.1.0
APP_DEBUG=false
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://<db-user>:<db-password>@postgres:5432/<db-name>?connect_timeout=5
DATABASE_ECHO=false

JWT_SECRET=<replace-with-strong-jwt-secret>
INGEST_API_KEY=<replace-with-strong-ingest-api-key>

ENABLE_AI=false
ENABLE_TELEGRAM=false

# Comma-separated browser origins allowed to call the API. Empty disables CORS.
CORS_ORIGINS=

POSTGRES_DB=finance
POSTGRES_USER=finance_app
POSTGRES_PASSWORD=<replace-with-strong-postgres-password>
