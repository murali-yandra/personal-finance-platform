APP_ENV=development
APP_NAME=Personal Finance Tracking Platform
APP_VERSION=0.1.0
APP_DEBUG=false
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://<db-user>:<db-password>@postgres:5432/<db-name>?connect_timeout=5
DATABASE_ECHO=false

JWT_SECRET=<replace-with-strong-jwt-secret>
INGEST_API_KEY=<replace-with-strong-ingest-api-key>
# Email of the user that owns messages sent to /api/v1/ingest/sms.
INGEST_USER_EMAIL=

ENABLE_AI=false
ENABLE_TELEGRAM=false

# Required only when ENABLE_TELEGRAM=true.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Required only when ENABLE_AI=true.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3

# Comma-separated browser origins allowed to call the API. Empty disables CORS.
CORS_ORIGINS=

RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100

POSTGRES_DB=finance
POSTGRES_USER=finance_app
POSTGRES_PASSWORD=<replace-with-strong-postgres-password>
